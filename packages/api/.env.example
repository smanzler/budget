# @budget/api — copy to .env and fill in
# Schema of record: src/env.ts

# --- Auth (better-auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL the API is reachable at
BETTER_AUTH_URL=http://localhost:24000

# --- Database ---
# Matches the credentials created by docker/postgres/init.sql
DATABASE_URL=postgresql://budget:budget@localhost:25432/budget

# --- Server ---
# Optional, defaults to 24000
PORT=24000
# Optional, defaults to http://localhost:23000
CLIENT_ORIGIN=http://localhost:23000

# --- Object storage (S3-compatible, used by the avatar router) ---
BUCKET_REGION=us-east-2
BUCKET_ACCESS_KEY_ID=test
BUCKET_SECRET_KEY=test
BUCKET_NAME=bucket
# Public base URL objects are served from, no trailing slash
BUCKET_URL=http://localhost:9090/bucket
# S3 API endpoint. Unset for AWS itself; every other service needs it.
BUCKET_ENDPOINT=http://localhost:9090

# --- Email / SMTP (email OTP delivery) ---
# Defaults target the mailpit container from docker/docker-compose.yml.
# Leave these unset for local dev; inbox UI is at http://localhost:28025
SMTP_HOST=localhost
SMTP_PORT=21025
# CAUTION: parsed with z.coerce.boolean(), so ANY non-empty value is true —
# including the literal "false". To disable TLS, leave this unset or empty.
SMTP_SECURE=
# Optional; auth is only sent when BOTH user and password are set
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Budget <noreply@budget.local>

# --- Push notifications (Expo) ---
# Optional. Only needed for sending to the Expo push service with an
# access token; unset works for unauthenticated sends.
EXPO_ACCESS_TOKEN=
