# Local infrastructure — copy to docker/.env and fill in
# Consumed by docker-compose.yml (env_file) for the database and pgadmin services.

# --- PostgreSQL (superuser) ---
# The application user/database (template/template) is created by postgres/init.sql
POSTGRES_PASSWORD=postgres

# --- pgAdmin (http://localhost:15433) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
